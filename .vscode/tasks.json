{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build with AddressSanitizer",
            "command": "g++",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-fsanitize=address",
                "-fno-omit-frame-pointer"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compiler task with AddressSanitizer enabled."
        }
    ]
}